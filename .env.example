# Copy this file to .env, then enter your own values. Never commit .env.

# Azure PostgreSQL (optional; omit to use the local SQLite database)
# THERAPY_SCHEDULER_DATABASE_URL=postgresql+psycopg://<user>:<url-encoded-password>@<server>:5432/postgres?sslmode=require

# WhatsApp Cloud API. Set the values as Azure Container App secrets in
# production; do not commit actual values. The template and recipient settings
# are only used by the backend-only test command.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEST_RECIPIENT=
WHATSAPP_TEST_PARAMETER_1=Test
WHATSAPP_TEST_PARAMETER_2=Tuesday, 14 October at 10:20 AM
WHATSAPP_TEST_QUICK_REPLY_PAYLOAD=help

# Azure OpenAI scheduling assistant (optional). The deployment must support
# structured JSON output. Keep the actual key in .env and never commit it.
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional: use the full Azure Responses API target URI supplied by the deployment.
AZURE_OPENAI_RESPONSES_URL=

# Zoho Creator OAuth client created in the India data centre
ZOHO_CREATOR_CLIENT_ID=
ZOHO_CREATOR_CLIENT_SECRET=
# Created automatically after the first approved Zoho connection. Keep secret.
ZOHO_CREATOR_REFRESH_TOKEN=

# These defaults already match the shared Creator application. Keep them unless
# the app, form, or report is renamed.
ZOHO_CREATOR_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_CREATOR_API_URL=https://www.zohoapis.in
ZOHO_CREATOR_REDIRECT_URI=http://127.0.0.1:8765/oauth/zoho/callback
ZOHO_CREATOR_ACCOUNT_OWNER=christina.sunil_turnb
ZOHO_CREATOR_APP_LINK_NAME=therapy-scheduler
ZOHO_CREATOR_FORM_LINK_NAME=All_Therapy_Schedules
ZOHO_CREATOR_REPORT_LINK_NAME=All_Therapy_Schedules_Report
ZOHO_CREATOR_PLAN_DETAIL_REPORT_LINK_NAME=Plan_Detail_Report

# The configured form has these native plain-text field link names.
ZOHO_CREATOR_FIELD_APPOINTMENT_ID=Appointment_ID
ZOHO_CREATOR_FIELD_PATIENT=Patient
ZOHO_CREATOR_FIELD_THERAPIST=Therapist
ZOHO_CREATOR_FIELD_THERAPY_TYPE=Therapy_Type
ZOHO_CREATOR_FIELD_BRANCH=Branch
ZOHO_CREATOR_FIELD_THERAPY_PLAN=Therapy_Plan
ZOHO_CREATOR_FIELD_APPOINTMENT_DATE=Appointment_Date
ZOHO_CREATOR_FIELD_START_TIME=Start
ZOHO_CREATOR_FIELD_END_TIME=End_Time
ZOHO_CREATOR_FIELD_DURATION_MINUTES=Duration_Minutes
ZOHO_CREATOR_FIELD_STATUS=Status
ZOHO_CREATOR_FIELD_NOTES=Notes
