# Sender secrets may be reused from the repository's ignored .env.
# These flow-specific settings do not affect the main application.
# session: coworker sends START first; real interactive buttons need no template.
# template: proactive offers require the matching approved template below.
FLOW_TEST_MESSAGE_MODE=session
FLOW_TEST_TEMPLATE_NAME=
FLOW_TEST_TEMPLATE_LANGUAGE=en_US
# Match the exact number/order of body parameters in your approved template.
# Supported placeholders: patient, visit_details, reference, centre, date, time,
# greeting_name, therapy, date_display, schedule.
FLOW_TEST_TEMPLATE_PARAMETERS=["{patient}", "{visit_details}"]
# Only when using template mode: template must have 3 quick-reply buttons in order:
# Confirm attendance, Cannot attend, Help. See README for the follow-up commands.
FLOW_TEST_OFFER_MINUTES=600
# Different parent numbers can send concurrently; shared numbers stay ordered.
FLOW_TEST_SEND_BATCH_SIZE=5
# Live mode can share the existing database through an isolated test schema.
# Provisioning writes a restricted DB login here; it leaves WhatsApp settings alone.
# FLOW_TEST_DATABASE_URL=postgresql+psycopg://flow_test_app:password@host:5432/postgres?sslmode=require
# FLOW_TEST_DATABASE_SCHEMA=flow_test
# Default preview stays local. Optional PostgreSQL preview uses its own schema:
# FLOW_TEST_PREVIEW_DATABASE_URL=postgresql+psycopg://flow_test_preview_app:password@host:5432/postgres?sslmode=require
# FLOW_TEST_PREVIEW_DATABASE_SCHEMA=flow_test_preview
# Optional persistent admin token; otherwise a random one is generated at startup.
FLOW_TEST_ADMIN_TOKEN=
# The /test workspace is served by the existing app. Default is preview.
# Enable after configuring the test schema, sender credentials and admin key.
# Zoho Parent No. fields supply contacts; no separate recipient list is required.
FLOW_TEST_LIVE=false
# Azure may inject base64-encoded recipients JSON as a secret instead of a file.
# When nonblank, this overrides recipients.local.json (including greeting names).
# FLOW_TEST_RECIPIENTS_B64=<base64 of recipients.local.json>
